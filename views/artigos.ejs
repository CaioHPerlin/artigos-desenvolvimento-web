<!DOCTYPE html>
<html>
  <head>
    <title>Artigos</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap");

      body {
        font-family: "Ubuntu", sans-serif;
      }

      table {
        border-collapse: collapse;
        width: 80%;
        margin: auto;
      }
      th,
      td {
        border: 1px solid #012959;
        padding: 10px;
        text-align: center;
      }

      th {
        background-color: #594299;
        color: white;
      }

      .signature {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: #fff;
      }

      .not-found {
        padding: 1rem;
      }
    </style>
  </head>
  <body>
    <h1 style="text-align: center">Artigos</h1>
    <table>
      <thead>
        <tr>
          <th>Título</th>
          <th>Descrição</th>
          <th>Autor</th>
          <th>Páginas</th>
        </tr>
      </thead>
      <tbody>
        <% if (artigos.length === 0) { %>
          <td class="not-found" colspan="3">Nenhum artigo encontrado.</td>
        <% } %>
        <% artigos.forEach(h => { %>
        <tr>
          <td><%= h.titulo %></td>
          <td><%= h.descricao %></td>
          <td><%= h.autor %></td>
          <td><%= h.paginas %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="signature">
      <p>
        Desenvolvido por Caio Hygino Perlin de Lima - <%= new
        Date().getFullYear() %>
      </p>
    </div>
  </body>
</html>
