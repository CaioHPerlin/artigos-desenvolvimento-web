<!DOCTYPE html>
<html>
  <head>
    <title>Horários de Aula</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap");

      body {
        font-family: "Ubuntu", sans-serif;
      }

      table {
        border-collapse: collapse;
        width: 80%;
        margin: auto;
      }
      th,
      td {
        border: 1px solid #012959;
        padding: 10px;
        text-align: center;
      }
      th {
        background-color: #594299;
        color: white;
      }
    </style>
  </head>
  <body>
    <h1 style="text-align: center">Artigos</h1>
    <table>
      <thead>
        <tr>
          <th>Título</th>
          <th>Descrição</th>
          <th>Páginas</th>
        </tr>
      </thead>
      <tbody>
        <% artigos.forEach(h => { %>
        <tr>
          <td><%= h.titulo %></td>
          <td><%= h.descricao %></td>
          <td><%= h.paginas %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </body>
</html>
